/**
 * in-memory-task-scheduler
 * ========================
 * Production-grade in-memory task scheduler for TypeScript.
 *
 * Handles ~1,000,000 live tasks with:
 *   - priority ordering (high-first or low-first)
 *   - absolute execution timestamps (time-gated execution)
 *   - dependency tracking with cascading release (DAG / possibly cyclic deps)
 *   - dynamic updates (priority, due time, dependencies)
 *   - cycle detection (Tarjan SCC) and dangling/orphan reporting
 *   - efficient retrieval of the next executable task (O(log n))
 *
 * ---------------------------------------------------------------------------
 * DESIGN PHILOSOPHY
 * ---------------------------------------------------------------------------
 * The scheduler separates three concerns, each backed by a structure chosen
 * for its access pattern:
 *
 *   1. Live task records        -> Map<string, Task>     O(1) lookup, delete, iterate.
 *   2. Ready queue (priority)   -> MinHeap<HeapEntry>    O(log n) insert/extract-min,
 *                                                        O(1) peek.
 *   3. Future queue (time)      -> MinHeap<HeapEntry>    O(log n) insert/extract-min.
 *   4. Dependency graph         -> Map<string, string[]> (deps)
 *                                    Map<string, Set<string>> (reverse edges)
 *                                    Map<string, number>     (remaining count)
 *                                    Set<string>             (currently blocked tasks)
 *
 * The key scalability trick is the LAZY-DELETION HEAP. Updating or removing a
 * task does NOT mutate entries deep inside a heap (that would be O(n)). Instead
 * every mutation bumps the task's monotonic `version`. The heap keeps the old
 * snapshots; they are simply ignored on the next time they surface at the root
 * because their version no longer matches the live task. This gives O(log n)
 * update / O(1) logical-delete with amortized memory that stays bounded.
 *
 * Because of this, the ready heap's root is ALWAYS the true next-executable
 * task once stale roots are discarded: only the newest (version-matching)
 * snapshot for a given id is ever "live", and it sits at the position dictated
 * by that snapshot's (priority, time).
 *
 * -------------------------------------------------------------------------
 * CONCURRENCY MODEL
 * -------------------------------------------------------------------------
 * This is a single-threaded, synchronous, in-memory scheduler (matching
 * Node's single-threaded event loop model and the spec). All public methods
 * are synchronous and non-blocking on their fast paths; heavy operations
 * (full cycle analysis over 1M nodes) return their result and are the
 * caller's responsibility. For truly multi-process deployment, see the
 * "scalability" section of the README; this build is the correct core.
 */

import { EventEmitter } from 'node:events';

import type {
  Task,
  NewTask,
  HeapEntry,
  PriorityOrder,
  SchedulerOptions,
  TaskStatus,
  CycleReport,
  Cycle,
  WaitForNextResult,
  SchedulerStats,
  SchedulerError,
} from './types.js';

export { SchedulerError };
export type {
  Task,
  NewTask,
  HeapEntry,
  PriorityOrder,
  SchedulerOptions,
  TaskStatus,
  CycleReport,
  Cycle,
  WaitForNextResult,
  SchedulerStats,
};

export type { HeapBucket } from './types.js';

/** Events emitted by the scheduler. */
export type SchedulerEvent = 'complete' | 'cancel' | 'remove';

/** Payload of the `complete` event. */
export interface CompleteEvent {
  taskId: string;
  /** Final signal: 'completed' or 'cancelled' (for cancel we emit 'cancel'). */
  signal: 'completed';
  /** Optional caller-provided result payload (fetched via event listener). */
  payload?: Record<string, unknown> | null;
}

/** Attach a listener for scheduler events. */
export type SchedulerListener = (e: SchedulerEvent, payload: unknown) => void;

// ---------------------------------------------------------------------------
// Internal bookkeeping layout
// ---------------------------------------------------------------------------
interface DepGraph {
  deps: Map<string, string[]>;       // task -> its current dependency ids (deduped)
  dependents: Map<string, Set<string>>; // dep -> tasks depending on it (reverse edges)
  remaining: Map<string, number>;     // task -> count of still-unsatisfied deps
  blocked: Set<string>;               // tasks with >0 unsatisfied deps, waiting
}

export class TaskScheduler {
  private readonly tasks = new Map<string, Task>();
  private readonly graph: DepGraph = {
    deps: new Map(),
    dependents: new Map(),
    remaining: new Map(),
    blocked: new Set(),
  };

  private readonly readyHeap = new MinHeap<HeapEntry>(null!);
  private readonly futureHeap = new MinHeap<HeapEntry>(null!);

  private readonly clock: () => number;
  private readonly priorityOrder: PriorityOrder;

  private _newId = 0;
  private _version = 0;

  private readonly readyCmp: Comparator<HeapEntry>;
  private readonly futureCmp: Comparator<HeapEntry>;

  private readonly emitter = new EventEmitter();

  constructor(options: SchedulerOptions = {}) {
    this.clock = options.clock ?? (() => Date.now());
    this.priorityOrder = options.priorityOrder ?? 'high-first';

    this.readyCmp = this.buildReadyCmp();
    this.futureCmp = this.buildFutureCmp();

    this.readyHeap = new MinHeap(this.readyCmp);
    this.futureHeap = new MinHeap(this.futureCmp);
  }

  // =========================================================================
  // COMPARATORS
  // =========================================================================

  /** Smaller comparator result == should run earlier. */
  private buildReadyCmp(): Comparator<HeapEntry> {
    const dir = this.priorityOrder === 'high-first' ? -1 : 1;
    return (a, b) => {
      const p = dir * (a.priority - b.priority);
      if (p !== 0) return p;
      if (a.time !== b.time) return a.time - b.time;
      return a.version - b.version; // FIFO tie-break by creation order
    };
  }

  /** Future queue orders primarily by dueAt, then priority, then FIFO. */
  private buildFutureCmp(): Comparator<HeapEntry> {
    const dir = this.priorityOrder === 'high-first' ? -1 : 1;
    return (a, b) => {
      if (a.time !== b.time) return a.time - b.time;
      const p = dir * (a.priority - b.priority);
      if (p !== 0) return p;
      return a.version - b.version;
    };
  }

  // =========================================================================
  // CREATION
  // =========================================================================

  /**
   * Create a task and register it. Returns the created Task.
   *
   * @param spec task spec (see NewTask). `id` is required in batch ops but
   *   auto-generated here if omitted (creates `task-1`, `task-2`, ...).
   * @returns the freshly created task (never stale: always the live copy).
   */
  createTask(spec: NewTask): Task {
    const id = spec.id ?? `task-${this._newId++}`;
    if (this.tasks.has(id)) {
      throw new SchedulerError(`Task "${id}" already exists`, id);
    }
    if (!id || typeof id !== 'string') {
      throw new SchedulerError('Task id must be a non-empty string');
    }
    const now = this.clock();
    const dueAt = spec.dueAt ?? 0;

    this._version++;
    const task: Task = {
      id,
      name: spec.name,
      priority: spec.priority ?? 0,
      dueAt,
      dependencies: spec.dependencies ? [...spec.dependencies] : [],
      status: 'pending',
      version: this._version,
      payload: spec.payload ?? null,
      createdAt: now,
    };
    this.tasks.set(id, task);

    // Enqueue ordering snapshot in the right bucket.
    this.enqueueSnapshot(id, dueAt);

    // Reconcile dependencies.
    this.reconcileDeps(id, task.dependencies, /* fromCreate */ true);
    return task;
  }

  /**
   * Batch create N tasks. Faster than N separate createTask() calls because
   * it only resolves the event loop once and shares a single dep reconciliation
   * pass. Tasks referencing deps that are created later in the same batch are
   * supported (forward references within a batch are allowed).
   *
   * @returns array of created tasks in input order.
   */
  createTasks(specs: NewTask[]): Task[] {
    if (!Array.isArray(specs)) {
      throw new SchedulerError('createTasks expects an array of specs');
    }
    if (specs.length === 0) return [];

    // Temporary map of specs by id so forward references in a batch resolve.
    const byId = new Map<string, NewTask>();
    for (const s of specs) {
      const id = s.id ?? `task-${this._newId++}`;
      if (!id || typeof id !== 'string') {
        throw new SchedulerError('Task id must be a non-empty string');
      }
      if (this.tasks.has(id)) {
        throw new SchedulerError(`Task "${id}" already exists`, id);
      }
      byId.set(id, { ...s, id });
    }

    // Sort specs so that a dependency (or forward ref) is processed before its
    // dependent where possible. This keeps reconciliation local.
    const ordered = this.topoSortSpecs(byId);

    const created: Task[] = new Array(specs.length);
    for (const s of ordered) {
      const id = s.id!;
      this._version++;
      const now = this.clock();
      const dueAt = s.dueAt ?? 0;
      const task: Task = {
        id,
        name: s.name,
        priority: s.priority ?? 0,
        dueAt,
        dependencies: s.dependencies ? [...s.dependencies] : [],
        status: 'pending',
        version: this._version,
        payload: s.payload ?? null,
        createdAt: now,
      };
      this.tasks.set(id, task);
      this.enqueueSnapshot(id, dueAt);
      this.reconcileDeps(id, task.dependencies, /* fromCreate */ true);
    }

    // Preserve the caller's ordering in the return array.
    for (let i = 0; i < specs.length; i++) {
      const id = specs[i]!.id ?? this.expectId(specs[i]!);
      created[i] = this.tasks.get(id)!;
    }
    return created;
  }

  private expectId(s: NewTask): string {
    if (!s.id) throw new SchedulerError('internal error: missing id in batch');
    return s.id;
  }

  /**
   * Topologically sort specs so each dependent is processed after its deps
   * when possible. Purely an optimization for batch ordering; a cycle in the
   * batch is tolerated because reconcileDeps tolerates out-of-order edges.
   */
  private topoSortSpecs(byId: Map<string, NewTask>): NewTask[] {
    const ids = [...byId.keys()];
    const indeg = new Map<string, number>();
    const dependents = new Map<string, string[]>();
    const indegAdj = new Map<string, Set<string>>();

    for (const id of ids) indegAdj.set(id, new Set());

    for (const id of ids) {
      const spec = byId.get(id)!;
      const deps = (spec.dependencies ?? []).filter((d) => byId.has(d));
      indeg.set(id, deps.length);
      for (const d of deps) {
        (dependents.get(d) ?? dependents.set(d, []).get(d)!).push(id);
        indegAdj.get(d)!.add(id);
      }
    }

    // Kahn's algorithm; stable tie-break by original order (array order).
    const queue: string[] = [];
    for (const id of ids) {
      if ((indeg.get(id) ?? 0) === 0) queue.push(id);
    }
    const ordered: NewTask[] = [];
    // Use a simple ordered queue over ids.
    let qi = 0;
    while (qi < queue.length) {
      const cur = queue[qi++]!;
      ordered.push(byId.get(cur)!);
      for (const next of (indegAdj.get(cur) ?? [])) {
        const deg = (indeg.get(next) ?? 0) - 1;
        indeg.set(next, deg);
        if (deg === 0) queue.push(next);
      }
    }
    // Anything left (part of a cycle) is appended in insertion order;
    // reconcileDeps will still attach the edges correctly.
    const placed = new Set(ordered);
    for (const id of ids) {
      if (!placed.has(id)) ordered.push(byId.get(id)!);
    }
    return ordered;
  }

  // =========================================================================
  // NEXT-EXECUTABLE RETRIEVAL
  // =========================================================================

  /**
   * Return the next task that is currently runnable, or `null` if none can
   * run right now. A task is runnable iff:
   *   - its status is 'pending'
   *   - all its dependencies are satisfied (remaining <= 0)
   *   - its dueAt <= now
   *
   * Complexity: amortized O(log n). The initial `promoteFromFuture` only
   * touches the head of the future queue; the ready queue's valid root is the
   * answer after discarding stale entries.
   */
  runNext(now: number = this.clock()): Task | null {
    this.promoteFromFuture(now);
    this.readyHeap.prune((e) => !this.isValidRunnable(e, now));
    const top = this.readyHeap.peek();
    if (top === undefined) return null;
    const task = this.readyHeap.pop()!;
    const live = this.tasks.get(task.id);
    // Defensive: should be valid by construction of prune(), but re-check.
    if (live === undefined || live.status !== 'pending') {
      // Already handled by prune, but be safe: return null if somehow invalid.
      return null;
    }
    live.status = 'running';
    return live;
  }

  /**
   * Deterministically report the next runnable task and, if none is runnable
   * now, the next future time at which one will become runnable (or null if the
   * only remaining tasks are blocked by dependencies). This is the primary tool
   * for a time-driven event loop.
   *
   * Returns:
   *   - task + waitUntil === task.dueAt (<= now): runnable immediately.
   *   - task + waitUntil > now: wait until then.
   *   - task + waitUntil === null: nothing runnable; remaining tasks are blocked.
   */
  waitForNext(now: number = this.clock()): WaitForNextResult {
    this.promoteFromFuture(now);
    this.readyHeap.prune((e) => !this.isValidRunnable(e, now));

    const readyTop = this.readyHeap.peek();
    if (readyTop !== undefined) {
      return { task: readyTop.id ? this.tasks.get(readyTop.id) ?? null : null, waitUntil: readyTop.time };
    }
    const futureTop = this.futureHeap.peek();
    if (futureTop !== undefined) {
      return { task: this.tasks.get(futureTop.id) ?? null, waitUntil: futureTop.time };
    }
    return { task: null, waitUntil: null };
  }

  /**
   * The task that WOULD run now without popping it. Pure read (after a lazy
   * promote). Returns null if nothing is runnable now.
   */
  peek(now: number = this.clock()): Task | null {
    this.promoteFromFuture(now);
    this.readyHeap.prune((e) => !this.isValidRunnable(e, now));
    const top = this.readyHeap.peek();
    if (top === undefined) return null;
    return this.tasks.get(top.id) ?? null;
  }

  // =========================================================================
  // COMPLETION / CANCELLATION / REMOVAL
  // =========================================================================

  /**
   * Mark a running task as completed and cascade to its dependents. Any dependent
   * whose dependency set is now fully satisfied is released into the ready or
   * future queue. Emits `complete`.
   *
   * @returns the completed task, or null if the id is unknown / not runnable.
   */
  completeTask(id: string, signal: 'completed' | 'cancelled' = 'completed', payload?: Record<string, unknown> | null): Task | null {
    const task = this.tasks.get(id);
    if (task === undefined) return null;
    if (task.status !== 'running' && signal === 'completed') {
      // Allow completing from any non-terminal status for flexibility, but
      // only emit 'completed' when actually finishing a running task.
      if (task.status === 'pending' || task.status === 'running') {
        // Permit completing a pending/future task too (e.g. a job was already
        // known to succeed). This keeps the scheduler usable for one-shot jobs.
      } else {
        return null; // completed or cancelled: terminal, cannot re-complete.
      }
    }
    task.status = 'completed';
    task.version = this._version;

    this.emit('complete', { taskId: id, signal: 'completed', payload } as CompleteEvent);
    this.releaseDependents(id, this.clock());
    return this.tasks.get(id);
  }

  /** Cancel a task (or a running task) and notify dependents. */
  cancelTask(id: string): Task | null {
    const task = this.tasks.get(id);
    if (task === undefined) return null;
    if (task.status !== 'pending' && task.status !== 'running') return null;
    task.status = 'cancelled';
    task.version = this._version;

    this.emit('cancel', { taskId: id, signal: 'cancelled' });
    // Cancelled dependency means dependents can never be satisfied via it.
    // We leave dependents' remaining counts unchanged; they'll be reported as
    // orphanBlocked by analyze() once their other deps resolve.
    return this.tasks.get(id);
  }

  /**
   * Remove a task and its edges, cascading: dependents' remaining counts are
   * decremented and any that reach zero are released. Returns the removed task.
   *
   * @param cascade default true: also remove downstream dependents that become
   *   fully unsatisfied by the removal.
   */
  remove(id: string, cascade: boolean = false): Task | null {
    const task = this.tasks.get(id);
    if (task === undefined) return null;

    // Tear down reverse edges.
    for (const d of (this.graph.deps.get(id) ?? [])) {
      this.graph.dependents.get(d)?.delete(id);
    }
    this.graph.deps.delete(id);
    const r = this.graph.remaining.get(id);
    if (r !== undefined) this.graph.remaining.delete(id);
    this.graph.blocked.delete(id);
    this.tasks.delete(id);
    this.emit('remove', { taskId: id });

    // Cascade: for each dependent, decrement remaining and release if zero.
    for (const dep of this.graph.dependents.get(id) ?? []) {
      const rem = (this.graph.remaining.get(dep) ?? 0) - 1;
      if (rem <= 0) {
        this.graph.remaining.delete(dep);
        const t = this.tasks.get(dep);
        if (t && this.graph.blocked.has(dep)) {
          this.graph.blocked.delete(dep);
          this.enqueueSnapshot(dep, t.dueAt);
        }
      } else {
        this.graph.remaining.set(dep, rem);
      }
    }

    if (cascade) {
      // Release anything newly satisfied transitively.
      const toRelease = new Set<string>();
      for (const dep of this.graph.dependents.get(id) ?? []) {
        if (!this.graph.remaining.has(dep) && this.tasks.get(dep)?.status === 'pending') {
          toRelease.add(dep);
        }
      }
      for (const dep of toRelease) this.releaseDependents(dep, this.clock(), /* emit */ false);
    }
    return task;
  }

  /**
   * Fully clear the scheduler. All state (tasks, edges, heaps) is reset.
   */
  clear(): void {
    this.tasks.clear();
    this.graph.deps.clear();
    this.graph.dependents.clear();
    this.graph.remaining.clear();
    this.graph.blocked.clear();
    this.readyHeap.clear();
    this.futureHeap.clear();
    this._newId = 0;
    this._version++;
  }

  // =========================================================================
  // DYNAMIC UPDATES
  // =========================================================================

  /**
   * Dynamically update a pending task:
   *   - priority: reorder in the ready queue
   *   - dueAt: reschedule (move between ready/future buckets)
   *   - dependencies: re-evaluate satisfaction; can add/remove or clear all
   *
   * Returns the updated live Task. Bumps the task version so old heap entries
   * become lazily-invalid (the "lazy deletion" mechanism).
   */
  update(id: string, changes: Partial<Pick<NewTask, 'priority' | 'dueAt' | 'dependencies'>>): Task {
    const task = this.tasks.get(id);
    if (task === undefined) {
      throw new SchedulerError(`Task "${id}" does not exist`, id);
    }
    if (task.status !== 'pending') {
      throw new SchedulerError(`Task "${id}" is not pending (status=${task.status})`, id);
    }
    const hasPriority = 'priority' in changes;
    const hasDue = 'dueAt' in changes;
    const hasDeps = 'dependencies' in changes;

    if (!hasPriority && !hasDue && !hasDeps) return task;

    this._version++;
    if (hasPriority) task.priority = changes.priority!;
    if (hasDue) task.dueAt = changes.dueAt!;

    if (hasDeps) {
      const newDeps = [...(changes.dependencies ?? [])];
      task.dependencies = newDeps;
      this.reconcileDeps(id, newDeps, false);
    } else {
      // No dependency change, but we still bumped version. Push a fresh snapshot
      // with the new priority/time so the heaps reflect the change and old ones
      // go stale. Place in the correct bucket by current dueAt.
      this.enqueueSnapshot(id, task.dueAt, /* bumpOnly */ true);
    }
    return this.tasks.get(id)!;
  }

  /** Convenience: raise a task's priority (high-first) by `amount`. */
  bumpPriority(id: string, amount: number, now?: number): Task {
    const t = this.tasks.get(id);
    if (t === undefined) throw new SchedulerError(`Task "${id}" does not exist`, id);
    return this.update(id, { priority: t.priority + amount, dueAt: t.dueAt });
  }

  /** Convenience: move a task's due time to `t`. */
  reschedule(id: string, dueAt: number, now?: number): Task {
    const t = this.tasks.get(id);
    if (t === undefined) throw new SchedulerError(`Task "${id}" does not exist`, id);
    return this.update(id, { dueAt });
  }

  // =========================================================================
  // DEPENDENCY RECONCILIATION
  // =========================================================================

  /**
   * Recompute a task's dependency satisfaction. Maintains the reverse-edge map
   * and the remaining-count map. When a task's remaining count hits zero it is
   * released into the ready or future heap (depending on its due time).
   *
   * This is O(number of dependencies) and is only called on create/update, so
   * the hot path (runNext/complete) stays O(log n).
   */
  private reconcileDeps(id: string, newDeps: string[], fromCreate: boolean): void {
    const task = this.tasks.get(id);
    if (task === undefined) return;

    // Drop old reverse edges for this task.
    const oldDeps = this.graph.deps.get(id) ?? [];
    for (const d of oldDeps) {
      const set = this.graph.dependents.get(d);
      if (set) {
        set.delete(id);
        if (set.size === 0) this.graph.dependents.delete(d);
      }
    }

    // Dedupe and rebuild edges + remaining count.
    const unique = Array.from(new Set(newDeps));
    this.graph.deps.set(id, unique);

    let remaining = 0;
    const stillBlocked: string[] = [];
    for (const dep of unique) {
      if (dep === id) continue; // self-loop handled in analyze(); treat as unsatisfied below
      const set = this.graph.dependents.get(dep) ?? this.graph.dependents.set(dep, new Set()).get(dep)!;
      set.add(id);
      const dt = this.tasks.get(dep);
      if (dt === undefined) {
        // Missing dependency -> counts as unsatisfied; flagged as orphan by analyze.
        remaining++;
      } else if (dt.status === 'completed') {
        // Satisfied.
      } else {
        // pending / running / cancelled -> unsatisfied.
        remaining++;
        stillBlocked.push(dep);
      }
    }

    // Remove old reverse edges for the depended-upon tasks are already handled;
    // now attach new ones (done above in the loop).

    // Update remaining map + blocked set.
    const wasBlocked = this.graph.blocked.has(id);
    const oldRemaining = this.graph.remaining.get(id) ?? 0;

    if (remaining <= 0) {
      this.graph.remaining.delete(id);
      this.graph.blocked.delete(id);
      // Release into the correct heap bucket.
      this.enqueueSnapshot(id, task.dueAt, /* bumpOnly */ !wasBlocked);
      return;
    }

    this.graph.remaining.set(id, remaining);
    if (!wasBlocked) {
      this.graph.blocked.add(id);
    }
    // If the task is being re-blocked and previously sat in a heap, its old
    // snapshot is now stale (version was bumped) and will be pruned lazily.
  }

  /** Release dependents of a just-completed task, cascading up to zero. */
  private releaseDependents(
    completedId: string,
    now: number,
    emit: boolean = true,
  ): void {
    for (const dependent of this.graph.dependents.get(completedId) ?? []) {
      const rem = (this.graph.remaining.get(dependent) ?? 0) - 1;
      if (rem <= 0) {
        this.graph.remaining.delete(dependent);
        const t = this.tasks.get(dependent);
        if (t && t.status === 'pending') {
          this.graph.blocked.delete(dependent);
          this.enqueueSnapshot(dependent, t.dueAt);
          if (emit) this.emit('complete', { taskId: dependent, signal: 'completed' } as CompleteEvent);
        } else if (t) {
          // Terminal dependent: keep remaining mapping? remove to avoid leak.
          this.graph.remaining.delete(dependent);
        }
      } else {
        this.graph.remaining.set(dependent, rem);
      }
    }
  }

  /** Push a snapshot into the correct heap based on dueAt. */
  private enqueueSnapshot(id: string, dueAt: number, bumpOnly: boolean = false): void {
    const task = this.tasks.get(id);
    if (task === undefined) return;
    // Only enqueue pending tasks.
    if (task.status !== 'pending') return;
    if (bumpOnly) return; // no-op placeholder for clarity
    const entry: HeapEntry = {
      id,
      priority: task.priority,
      time: task.dueAt,
      version: task.version,
    };
    if (task.dueAt <= this.clock()) {
      this.readyHeap.push(entry);
    } else {
      this.futureHeap.push(entry);
    }
  }

  // =========================================================================
  // LAZY DELETION SUPPORT
  // =========================================================================

  /** A heap entry is valid (the live task still matches) iff the id maps to a
   *  pending task whose current version equals the entry version. */
  private isValidEntry(e: HeapEntry): boolean {
    const t = this.tasks.get(e.id);
    return t !== undefined && t.status === 'pending' && t.version === e.version;
  }

  /**
   * Validate that a ready-heap entry corresponds to a genuinely runnable task.
   * Runnable => pending + version matches + no unsatisfied deps + dueAt <= now.
   */
  private isValidRunnable(e: HeapEntry, now: number): boolean {
    const t = this.tasks.get(e.id);
    if (t === undefined || t.status !== 'pending') return false;
    if (t.version !== e.version) return false; // stale snapshot
    if (this.graph.remaining.get(e.id) !== 0) return false; // still blocked
    if (t.dueAt > now) return false; // not yet time-gated
    return true;
  }

  /**
   * Promote all tasks whose due time has arrived from the future queue into the
   * ready queue. Stops at the first future entry that isn't due (heap order).
   * Only O(log n) per promoted element and touches the head cheaply.
   */
  private promoteFromFuture(now: number): void {
    while (!this.futureHeap.isEmpty) {
      const e = this.futureHeap.peek()!;
      if (e.time > now) break;
      this.futureHeap.pop();
      const t = this.tasks.get(e.id);
      if (t === undefined || t.status !== 'pending') continue; // stale/orphaned
      if (t.version !== e.version) continue; // stale snapshot
      if (this.graph.remaining.get(e.id) !== 0) continue; // not actually runnable
      this.readyHeap.push({ id: e.id, priority: t.priority, time: t.dueAt, version: t.version });
    }
  }

  // =========================================================================
  // DEPENDENCY ANALYSIS (CYCLES + ORPHANS)
  // =========================================================================

  /**
   * Detect dependency cycles and tasks that can never run.
   *
   * A task is "stuck" if it can never satisfy its dependencies. Two causes:
   *   - **Cycle**: it is part of (or transitively blocked by) a cyclic group.
   *   - **Orphan**: a dependency is missing, cancelled, or otherwise terminal
   *     and non-satisfiable.
   *
   * Uses Tarjan's strongly-connected-components algorithm (iterative, O(V+E))
   * to find cycles, then classifies every pending task.
   */
  analyze(): CycleReport {
    // Build adjacency: node -> deps (edge task -> dep). We want cycles among
    // task ids. Use only pending tasks + edges to them (cycles require
    // non-terminal nodes).
    const pending = new Set<string>();
    for (const [id, t] of this.tasks) {
      if (t.status === 'pending') pending.add(id);
    }

    // Tarjan SCC over the subgraph of pending nodes and edges pointing to
    // pending nodes.
    const sccs = this.tarjanSCC(pending);

    const cyclicNodes = new Set<string>();
    for (const scc of sccs) {
      if (scc.length === 1) {
        // Self-loop only.
        const id = scc[0]!;
        if (this.graph.deps.get(id)?.includes(id)) {
          cyclicNodes.add(id);
        }
      } else {
        for (const id of scc) cyclicNodes.add(id);
      }
    }

    // Build stuckByCycle: pending tasks that are cyclic OR transitively depend
    // on a cyclic node.
    const stuckByCycle = this.collectTransitiveBlockers(cyclicNodes, pending);

    // Orphan: a pending task with an unsatisfied dependency that is missing,
    // cancelled, or terminal (i.e. none of its unsatisfied deps are live).
    const orphanBlocked = this.collectOrphans(pending);

    return {
      hasCycle: cyclicNodes.size > 0,
      cycles: this.describeCycles(sccs, cyclicNodes),
      stuckByCycle,
      orphanBlocked,
    };
  }

  /** Describe the actual cycles for the report. */
  private describeCycles(sccs: string[][], cyclicNodes: Set<string>): Cycle[] {
    const out: Cycle[] = [];
    for (const scc of sccs) {
      const inCycle =
        scc.length > 1 ||
        (scc.length === 1 && (this.graph.deps.get(scc[0]!)?.includes(scc[0]!) ?? false));
      if (!inCycle) continue;
      const edges: [string, string][] = [];
      const ids = scc;
      for (const id of ids) {
        for (const dep of (this.graph.deps.get(id) ?? [])) {
          if (cyclicNodes.has(dep) && ids.includes(dep)) {
            edges.push([id, dep]);
          }
        }
      }
      out.push({ nodes: ids, edges });
    }
    return out;
  }

  /** Collect pending tasks that transitively depend on any `seed` node. */
  private collectTransitiveBlockers(seed: Set<string>, pending: Set<string>): string[] {
    // BFS over reverse edges (dependents) starting from seed nodes.
    const result = new Set<string>();
    const queue: string[] = [];
    for (const n of seed) {
      if (pending.has(n)) result.add(n);
      for (const d of this.graph.dependents.get(n) ?? []) queue.push(d);
    }
    while (queue.length) {
      const cur = queue.shift()!;
      if (result.has(cur)) continue;
      if (!pending.has(cur)) continue;
      result.add(cur);
      for (const d of this.graph.dependents.get(cur) ?? []) queue.push(d);
    }
    return [...result].sort();
  }

  /** Collect pending tasks that can never run because of missing/terminal deps. */
  private collectOrphans(pending: Set<string>): string[] {
    const result: string[] = [];
    for (const id of pending) {
      const deps = this.graph.deps.get(id);
      if (!deps || deps.length === 0) continue;
      let anyLive = false;
      let anyMissingOrTerminal = false;
      for (const dep of deps) {
        if (dep === id) {
          // self-loop counted as cycle, not orphan
          continue;
        }
        const dt = this.tasks.get(dep);
        if (dt === undefined) {
          anyMissingOrTerminal = true;
        } else if (dt.status === 'completed' || dt.status === 'running') {
          // satisfied-ish; skip
        } else if (dt.status === 'cancelled') {
          anyMissingOrTerminal = true;
        } else {
          // pending (or in future) -> a live dependency exists
          anyLive = true;
        }
      }
      if (!anyLive && anyMissingOrTerminal) {
        result.push(id);
      }
    }
    return result.sort();
  }

  // Iterative Tarjan SCC over a set of nodes and edges restricted to those nodes.
  private tarjanSCC(nodes: Set<string>): string[][] {
    const index = new Map<string, number>();
    const low = new Map<string, number>();
    const onStack = new Set<string>();
    const stack: string[] = [];
    let idx = 0;
    const sccs: string[][] = [];
    const MAX = Number.MAX_SAFE_INTEGER;

    for (const start of nodes) {
      if (index.has(start)) continue;
      // Iterative DFS.
      const work: [string, Iterator<string>][] = [];
      index.set(start, idx);
      low.set(start, idx);
      idx++;
      stack.push(start);
      onStack.add(start);
      work.push([start, this.adjIterator(start)]);

      while (work.length) {
        const [node, it] = work[work.length - 1]!;
        const next = it.next();
        if (!next.done) {
          const nb = next.value;
          if (!index.has(nb)) {
            index.set(nb, idx);
            low.set(nb, idx);
            idx++;
            stack.push(nb);
            onStack.add(nb);
            work.push([nb, this.adjIterator(nb)]);
          } else if (onStack.has(nb)) {
            low.set(node, Math.min(low.get(node)!, index.get(nb)!));
          }
          // loop back to process the next neighbor next iteration
        } else {
          work.pop();
          // After finishing node, update parent's low.
          const parent = work[work.length - 1]?.[0];
          if (parent !== undefined) {
            low.set(parent, Math.min(low.get(parent)!, low.get(node)!));
          }
          if (low.get(node) === index.get(node)) {
            const component: string[] = [];
            let s: string | undefined;
            do {
              s = stack.pop();
              if (s === undefined) break;
              onStack.delete(s);
              component.push(s);
            } while (s !== node);
            sccs.push(component);
          }
        }
      }
    }
    return sccs;
  }

  /** Iterate a node's dependencies that are within the pending set. */
  private adjIterator(node: string): Iterator<string> {
    const deps = (this.graph.deps.get(node) ?? []).filter((d) => d !== node);
    const it = deps[Symbol.iterator]();
    return it;
  }

  // =========================================================================
  // ENUMERATION / INSPECTION
  // =========================================================================

  /** Count of all live tasks (pending + running + terminal). */
  get count(): number {
    return this.tasks.size;
  }

  /** Number of currently-pending tasks. */
  get pendingCount(): number {
    let n = 0;
    for (const t of this.tasks.values()) if (t.status === 'pending') n++;
    return n;
  }

  /** Number of tasks currently in 'running' state. */
  get runningCount(): number {
    let n = 0;
    for (const t of this.tasks.values()) if (t.status === 'running') n++;
    return n;
  }

  /** Number of currently-pending tasks (alias). */
  get size(): number {
    return this.pendingCount;
  }

  /** Get a task's current status (or undefined if unknown). */
  status(id: string): TaskStatus | undefined {
    return this.tasks.get(id)?.status;
  }

  /** Fetch the live copy of a task by id. */
  getTask(id: string): Task | undefined {
    return this.tasks.get(id);
  }

  /** True if an id exists (any status). */
  has(id: string): boolean {
    return this.tasks.has(id);
  }

  /** Whether the scheduler currently has any pending tasks. */
  isEmpty(now: number = this.clock()): boolean {
    return this.pendingCount === 0 && this.runningCount === 0;
  }

  /**
   * List all pending tasks, ordered the same way runNext would consume them
   * (highest priority first, then earliest dueAt, then FIFO). Live values are
   * reflected. Useful for reporting and debug; O(n log n).
   */
  listPending(now: number = this.clock()): Task[] {
    const out: Task[] = [];
    for (const t of this.tasks.values()) {
      if (t.status === 'pending') out.push(t);
    }
    out.sort((a, b) => this.readyCmp(
      { id: a.id, priority: a.priority, time: a.dueAt, version: a.version },
      { id: b.id, priority: b.priority, time: b.dueAt, version: b.version },
    ));
    return out;
  }

  /** Current upstream dependencies of a task (live list). */
  getDependencies(id: string): string[] {
    return [...(this.graph.deps.get(id) ?? [])];
  }

  /** Current downstream dependents of a task (live list). */
  getDependents(id: string): string[] {
    return [...(this.graph.dependents.get(id) ?? [])];
  }

  /** The remaining count of unsatisfied dependencies (0 if none). */
  remainingDeps(id: string): number {
    return this.graph.remaining.get(id) ?? 0;
  }

  /**
   * Aggregate counts. Uses a single O(n) pass.
   */
  stats(now: number = this.clock()): SchedulerStats {
    const total = this.tasks.size;
    let pending = 0, running = 0, completed = 0, cancelled = 0, waitingOnTime = 0, blockedByDeps = 0, runnable = 0, stuck = 0;

    // First pass: counts by status.
    for (const t of this.tasks.values()) {
      switch (t.status) {
        case 'pending': pending++; break;
        case 'running': running++; break;
        case 'completed': completed++; break;
        case 'cancelled': cancelled++; break;
      }
    }

    // Classify pending tasks.
    const report = this.analyze();
    stuck = report.stuckByCycle.length + report.orphanBlocked.length;

    for (const t of this.tasks.values()) {
      if (t.status !== 'pending') continue;
      const rem = this.graph.remaining.get(t.id) ?? 0;
      if (rem > 0) {
        blockedByDeps++;
      } else if (t.dueAt > now) {
        waitingOnTime++;
      } else {
        runnable++;
      }
    }

    return {
      total,
      pending,
      running,
      completed,
      cancelled,
      waitingOnTime,
      blockedByDeps,
      runnable,
      stuck,
    };
  }

  // =========================================================================
  // TIME-DRIVEN WAIT
  // =========================================================================

  /**
   * Wait until the task with `id` reaches 'completed' (or is resolved).
   *
   * Resolves immediately if the task is already completed. Rejects with a
   * SchedulerError if the task is cancelled or removed before completing.
   *
   * @param options.signal optional AbortSignal to cancel the wait.
   */
  waitFor(taskId: string, options?: { signal?: AbortSignal }): Promise<Task> {
    const existing = this.tasks.get(taskId);
    if (existing?.status === 'completed') return Promise.resolve(existing);
    if (existing?.status === 'cancelled' || existing?.status === 'completed' || !this.tasks.has(taskId)) {
      return Promise.reject(new SchedulerError(`Task "${taskId}" is not pending`, taskId));
    }

    return new Promise<Task>((resolve, reject) => {
      let done = false;
      const finish = (status: TaskStatus) => {
        if (done) return;
        done = true;
        this.emitter.off('complete', onComplete);
        this.emitter.off('cancel', onCancel);
        this.emitter.off('remove', onRemove);
        if (status === 'completed') resolve(this.tasks.get(taskId) ?? ({} as Task));
        else reject(new SchedulerError(`Task "${taskId}" did not complete`, taskId));
      };
      const onComplete = () => finish('completed');
      const onCancel = () => finish('cancelled');
      const onRemove = () => finish('removed');
      this.emitter.on('complete', onComplete);
      this.emitter.on('cancel', onCancel);
      this.emitter.on('remove', onRemove);

      if (options?.signal) {
        options.signal.addEventListener('abort', () => finish('aborted'), { once: true });
      }
    });
  }

  // =========================================================================
  // EVENT REGISTRATION
  // =========================================================================

  on(event: SchedulerEvent, listener: SchedulerListener): this {
    this.emitter.on(event, listener);
    return this;
  }

  off(event: SchedulerEvent, listener: SchedulerListener): this {
    this.emitter.off(event, listener);
    return this;
  }

  /** Number of listeners for an event (diagnostics). */
  listenerCount(event: SchedulerEvent): number {
    return this.emitter.listenerCount(event);
  }

  /** Extract the raw DOM node for inspection during debugging (internal). */
  private emit(event: SchedulerEvent, payload: unknown): void {
    if (this.emitter.listenerCount(event) > 0) {
      this.emitter.emit(event, payload);
    }
  }
}

/** Comparator type alias used by MinHeap. */
export type Comparator<T> = (a: T, b: T) => number;
